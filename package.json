{
  "name": "saga-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx -y node@20 ./node_modules/next/dist/bin/next dev",
    "build": "npx -y node@20 ./node_modules/next/dist/bin/next build",
    "start": "npx -y node@20 ./node_modules/next/dist/bin/next start",
    "lint": "npx -y node@20 ./node_modules/eslint/bin/eslint.js app src middleware.ts next.config.mjs --ext .js,.mjs,.ts,.tsx --format unix",
    "typecheck": "npx -y node@20 ./node_modules/typescript/bin/tsc --noEmit --incremental false",
    "raffle": "tsx scripts/raffle.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "seed:giveaway": "tsx scripts/seed-giveaway-db.ts",
    "sync:entries": "tsx scripts/sync-entries.ts",
    "refresh:metrics": "tsx scripts/refresh-metrics.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "google-auth-library": "^10.4.1",
    "next": "^14.2.0",
    "openai": "^6.27.0",
    "prisma": "^6.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "playwright": "^1.58.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.21.0",
    "typescript": "^5.5.2"
  }
}
